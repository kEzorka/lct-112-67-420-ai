{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dds-ai/score-summary/0.3.0-draft",
  "$defs": {
    "Verdict": {
      "enum": [
        "passed",
        "not_passed",
        "provisional",
        "not_scored"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rubric_version": {
      "minLength": 1,
      "title": "Rubric Version",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "total": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total"
    },
    "lower": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lower"
    },
    "upper": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upper"
    },
    "effective_weights": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Effective Weights",
      "type": "object"
    },
    "excluded_groups": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Excluded Groups",
      "type": "array"
    },
    "critical_failures": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Critical Failures",
      "type": "array"
    }
  },
  "required": [
    "rubric_version",
    "verdict"
  ],
  "title": "ScoreSummary",
  "type": "object"
}
